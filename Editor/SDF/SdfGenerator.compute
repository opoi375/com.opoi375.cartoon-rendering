//
// GPU SDF 生成器，参考知乎专栏 p/702637242《写个GPU上运行的SDF生成器》。
// kernel 0/2: 每个像素横向扫描，记录到最近"障碍"像素的距离平方（白为障碍 / 黑为障碍）
// kernel 1/3: 每个像素纵向扫描，用 temp[j] + 纵向距离平方 开根取最小，得到正/负向 SDF，
//             最终输出 (pos - neg) * 0.5 + 0.5 并钳制到 [0,1]
// kernel 4:   多帧 SDF 插值合成渐变贴图（step(插值, 0.5) 逐级累加 1/255）
// 与 CPU 参考实现 SdfGeneratorCore / SdfGradientComposer 算法一致（有一致性测试保障）。

#pragma kernel SetHorizontalMinDist
#pragma kernel CalculateSDF
#pragma kernel SetHorizontalMinDist2
#pragma kernel CalculateSDF2
#pragma kernel CombineSDF

float _ScaleDown;
float2 _TexSize;
Texture2D<float> _OriginalTex;   // 输入的黑白遮罩图
RWTexture2D<float> _TempTex;     // 存储横向最小距离的临时贴图
RWTexture2D<float> _OutputTex;   // 输出的 SDF 图 / 渐变图

Texture2D<float> _SDF1;
Texture2D<float> _SDF2;
float _Weight;

#define FAR_DISTANCE_SQR 1e29

// 0 将原图 1 视作障碍，0 视作背景，寻找背景到障碍的横向最小距离
[numthreads(8,8,1)]
void SetHorizontalMinDist(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y) return;

    float currentColor = _OriginalTex[id.xy].r;

    // 当前中心像素是障碍物本身，设置为 0
    if (currentColor > 0.5)
    {
        _TempTex[id.xy] = 0;
        return;
    }

    // 每个点读取横向最小值
    float minDistance = FAR_DISTANCE_SQR;
    for (int i = 0; i < (int)_TexSize.x; i++)
    {
        float distance = (i - (int)id.x) * (i - (int)id.x);
        float color = _OriginalTex[uint2(i, id.y)].r;
        // 如果是障碍物，就对比中心像素到障碍物的距离和最小距离
        if (color > 0.5)
        {
            minDistance = min(minDistance, distance);
        }
    }
    _TempTex[id.xy] = minDistance;
}

// 1 每一列操作，将最小距离写入（正向 SDF）
[numthreads(8,8,1)]
void CalculateSDF(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y) return;

    float minDistance = 1e15;
    // 计算每一列的距离
    for (int i = 0; i < (int)_TexSize.y; i++)
    {
        // 每个像素到当前像素的距离
        float distance = (i - (int)id.y) * (i - (int)id.y);
        // 每个像素的横向最小距离平方
        float color = _TempTex[uint2(id.x, i)];
        // 相加后比较最小距离
        minDistance = min(minDistance, sqrt(max(distance + color, 0.0)));
    }
    _OutputTex[id.xy] = minDistance / _ScaleDown;
}

// 2 将原图 0 视作障碍，1 视作背景，寻找背景到障碍的横向最小距离
[numthreads(8,8,1)]
void SetHorizontalMinDist2(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y) return;

    float currentColor = _OriginalTex[id.xy].r;
    if (currentColor < 0.5)
    {
        _TempTex[id.xy] = 0;
        return;
    }

    float minDistance = FAR_DISTANCE_SQR;
    for (int i = 0; i < (int)_TexSize.x; i++)
    {
        float distance = (i - (int)id.x) * (i - (int)id.x);
        float color = _OriginalTex[uint2(i, id.y)].r;
        if (color < 0.5)
        {
            minDistance = min(minDistance, distance);
        }
    }
    _TempTex[id.xy] = minDistance;
}

// 3 每一列操作，计算最小距离（负向 SDF）。用正向 SDF 减去负向 SDF，并映射到 0-1
[numthreads(8,8,1)]
void CalculateSDF2(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y) return;

    float oriOutput = _OutputTex[id.xy];

    float minDistance = 1e15;
    for (int i = 0; i < (int)_TexSize.y; i++)
    {
        float distance = (i - (int)id.y) * (i - (int)id.y);
        float color = _TempTex[uint2(id.x, i)];
        minDistance = min(minDistance, sqrt(max(distance + color, 0.0)));
    }
    float dist2 = minDistance / _ScaleDown;
    _OutputTex[id.xy] = saturate((oriOutput - dist2) * 0.5 + 0.5);
}

// 4 合成 SDF：插值两帧 SDF，处于内部（<=0.5）的层级累加 1/255
[numthreads(8,8,1)]
void CombineSDF(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_TexSize.x || id.y >= (uint)_TexSize.y) return;

    float initColor = _OutputTex[id.xy];
    float sdf1 = _SDF1[id.xy];
    float sdf2 = _SDF2[id.xy];
    float col = step(sdf1 * _Weight + sdf2 * (1 - _Weight), 0.5);
    _OutputTex[id.xy] = initColor + col / 255.0;
}
